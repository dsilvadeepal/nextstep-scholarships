LIVE_CALLS_ENABLED=false
OPENAI_RUN_BUDGET_USD=0
OPENAI_TOTAL_BUDGET_USD=0
ENVIRONMENT=development
# Set secrets only in ignored .env or Replit Secrets.
# DATABASE_URL=postgresql+psycopg://...  (development database explicitly selected)
# PUBLIC_ORIGIN=https://your-confirmed-app.replit.app
# OIDC_CLIENT_ID=your-confirmed-Replit-client-id
# SESSION_SECRET=generate-at-least-32-random-characters
# RATE_SECRET=generate-a-separate-stable-random-secret
# ADMIN_SUBJECTS=["immutable-owner-subject"]
# APP_STORAGE_BUCKET_ID=your-confirmed-bucket
# OPENAI_API_KEY=server-secret
# ANSWER_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# PINECONE_API_KEY=server-secret
# PINECONE_INDEX=your-confirmed-cosine-index
# LANGSMITH_API_KEY=server-secret
# LANGSMITH_PROJECT=nextstep-fictional-evals
# PRICING_EFFECTIVE_DATE=verified-provider-pricing-date
# INPUT_USD_PER_MILLION=approved-current-input-price
# OUTPUT_USD_PER_MILLION=approved-current-output-price
# EMBEDDING_USD_PER_MILLION=approved-current-embedding-price
